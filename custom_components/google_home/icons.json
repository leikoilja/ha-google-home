{
  "entity": {
    "number": {
      "alarm_volume": {
        "default": "mdi:volume-high",
        "range": {
          "0": "mdi:volume-off",
          "1": "mdi:volume-low",
          "31": "mdi:volume-medium",
          "61": "mdi:volume-high"
        }
      }
    },
    "sensor": {
      "alarms": {
        "default": "mdi:alarm-multiple"
      },
      "device": {
        "default": "mdi:form-textbox-password"
      },
      "timers": {
        "default": "mdi:timer-sand"
      },
      "wifi_network": {
        "default": "mdi:wifi"
      }
    },
    "switch": {
      "do_not_disturb": {
        "default": "mdi:minus-circle"
      }
    },
    "event": {
      "alarm_events": {
        "default": "mdi:alarm-bell"
      },
      "timer_events": {
        "default": "mdi:timer-alert-outline"
      }
    }
  },
  "services": {
    "delete_alarm": {
      "service": "mdi:alarm-off"
    },
    "delete_all_alarms": {
      "service": "mdi:alarm-off"
    },
    "delete_all_timers": {
      "service": "mdi:timer-cancel"
    },
    "delete_timer": {
      "service": "mdi:timer-cancel"
    },
    "reboot_device": {
      "service": "mdi:restart"
    },
    "refresh_devices": {
      "service": "mdi:refresh"
    }
  }
}
