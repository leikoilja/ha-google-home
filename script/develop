#!/usr/bin/env bash
# Start a local Home Assistant on port 8123 with this integration available.
# The integration isn't set up yet: on the first start, create a Home Assistant
# user, then go to Settings > Devices & services > Add integration, choose
# Google Home and sign in. Home Assistant keeps the user and the integration in
# config/, so you do this once.
set -euo pipefail

cd "$(dirname "$0")/.."

# custom_components/ has no __init__.py, so Home Assistant picks it up as part
# of its custom_components namespace package from the repository root.
export PYTHONPATH="${PWD}${PYTHONPATH:+:${PYTHONPATH}}"

exec uv run hass --config "${PWD}/config" --debug
